# ==============================================================
# Green Data ETL & IA - Plantilla de Variables de Entorno (.env)
# Copia este archivo como .env y coloca tus valores correspondientes.
# ==============================================================

# REST API - World Air Quality Index (WAQI)
# Obtén tu token en: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=tu_token_waqi_aqui
WAQI_TARGET_STATION=A07441
WAQI_FALLBACK_STATION=@7441

# Ollama LLM Local Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Backend FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
